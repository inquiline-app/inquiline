@@ -0,0 +1,49 @@
+package com.genymobile.scrcpy.control;
+
+import android.net.LocalSocket;
+import android.net.LocalSocketAddress;
+
+import java.io.IOException;
+import java.io.OutputStream;
+import java.nio.ByteBuffer;
+import java.nio.ByteOrder;
+
+/**
+ * Inquiline: hands the Mac's motion (a game controller's or a phone's) to Android's sensors
+ * (Vendor/sensors), on their abstract socket, one packet of six little-endian floats each.
+ */
+final class InquilineSensors {
+    private static LocalSocket socket;
+    private static OutputStream out;
+    private static final ByteBuffer packet = ByteBuffer.allocate(24).order(ByteOrder.LITTLE_ENDIAN);
+
+    private InquilineSensors() {
+    }
+
+    static synchronized void send(float[] motion) {
+        try {
+            if (socket == null) {
+                LocalSocket made = new LocalSocket(LocalSocket.SOCKET_SEQPACKET);
+                made.connect(new LocalSocketAddress("inquiline-sensors", LocalSocketAddress.Namespace.ABSTRACT));
+                socket = made;
+                out = made.getOutputStream();
+            }
+            packet.clear();
+            for (float value : motion) {
+                packet.putFloat(value);
+            }
+            out.write(packet.array(), 0, 24);
+        } catch (IOException e) {
+            // No sensors yet, or they started again: the next motion connects anew.
+            try {
+                if (socket != null) {
+                    socket.close();
+                }
+            } catch (IOException ignored) {
+                // Already gone.
+            }
+            socket = null;
+            out = null;
+        }
+    }
+}
