@@ -0,0 +1,224 @@
+package com.genymobile.scrcpy.video;
+
+import com.genymobile.scrcpy.AsyncProcessor;
+import com.genymobile.scrcpy.model.ConfigurationException;
+import com.genymobile.scrcpy.model.Size;
+import com.genymobile.scrcpy.util.IO;
+import com.genymobile.scrcpy.util.Ln;
+
+import android.annotation.SuppressLint;
+import android.graphics.PixelFormat;
+import android.hardware.HardwareBuffer;
+import android.media.Image;
+import android.media.ImageReader;
+import android.os.Handler;
+import android.os.HandlerThread;
+import android.os.Looper;
+
+import java.io.FileDescriptor;
+import java.io.IOException;
+import java.nio.ByteBuffer;
+import java.time.Duration;
+import java.util.HashMap;
+import java.util.Map;
+import java.util.concurrent.LinkedBlockingQueue;
+import java.util.concurrent.TimeUnit;
+import java.util.concurrent.atomic.AtomicBoolean;
+
+/**
+ * Inquiline: sends the display's frames as the virtio-gpu resources Android drew them into,
+ * instead of encoding video. The Mac has gfxstream copy each resource into the window's
+ * memory, then returns the frame (control message TYPE_RELEASE_FRAME) for Android to reuse.
+ *
+ * The video socket carries the usual codec header, then for each size a session packet
+ * (int with its top bit set, width, height), and for each frame two ints: resource id and
+ * frame number.
+ */
+@SuppressLint("NewApi")
+public class FrameStreamer implements AsyncProcessor {
+
+    /** Written in place of a codec id, so a client expecting video stops at once. */
+    public static final int CODEC_ID_FRAMES = 0x6672_6d73; // "frms"
+
+    private static final int MAX_IMAGES = 4;
+    private static final long USAGE = HardwareBuffer.USAGE_GPU_SAMPLED_IMAGE | HardwareBuffer.USAGE_GPU_COLOR_OUTPUT;
+
+    static {
+        System.load("/data/local/tmp/libinquiline-frames.so");
+    }
+
+    private static native int resourceId(HardwareBuffer buffer);
+
+    private final SurfaceCapture capture;
+    private final CaptureControl captureControl = new CaptureControl();
+    private final FileDescriptor fd;
+    private final AtomicBoolean stopped = new AtomicBoolean();
+    private final LinkedBlockingQueue<Image> available = new LinkedBlockingQueue<>();
+    private final Map<Integer, Image> sent = new HashMap<>();
+    private Thread thread;
+    private int frameNumber;
+
+    public FrameStreamer(SurfaceCapture capture, FileDescriptor fd) {
+        this.capture = capture;
+        this.fd = fd;
+    }
+
+    /** The Mac is done with this frame. */
+    public void releaseFrame(int number) {
+        Image image;
+        synchronized (sent) {
+            image = sent.remove(number);
+        }
+        if (image != null) {
+            image.close();
+        }
+    }
+
+    private void stream() throws IOException, ConfigurationException {
+        capture.init(captureControl, new VideoConstraints(0, 4, null));
+        ByteBuffer header = ByteBuffer.allocate(12);
+        header.putInt(CODEC_ID_FRAMES).flip(); // where video sends its codec id
+        IO.writeFully(fd, header);
+
+        HandlerThread handlerThread = new HandlerThread("frames");
+        handlerThread.start();
+        Handler handler = new Handler(handlerThread.getLooper());
+        try {
+            while (!stopped.get()) {
+                int reasons = captureControl.consumeReset();
+                if ((reasons & CaptureControl.RESET_REASON_TERMINATED) != 0) {
+                    break;
+                }
+                capture.prepare();
+                Size size = capture.getSize();
+                ImageReader reader = ImageReader.newInstance(size.getWidth(), size.getHeight(), PixelFormat.RGBA_8888, MAX_IMAGES, USAGE);
+                reader.setOnImageAvailableListener(r -> {
+                    // Only the newest picture waits; older ones go back to Android at once. When
+                    // the Mac falls behind, as while another app loads, every buffer may be held:
+                    // this picture is then skipped rather than failing.
+                    Image old;
+                    while ((old = available.poll()) != null) {
+                        old.close();
+                    }
+                    try {
+                        Image image = r.acquireLatestImage();
+                        if (image != null) {
+                            available.add(image);
+                        }
+                    } catch (IllegalStateException e) {
+                        // All buffers are held
+                    }
+                }, handler);
+                capture.start(reader.getSurface());
+                try {
+                    header.clear();
+                    header.putInt(0x8000_0000).putInt(size.getWidth()).putInt(size.getHeight()).flip();
+                    IO.writeFully(fd, header);
+                    sendFrames();
+                } finally {
+                    capture.stop();
+                    reader.setOnImageAvailableListener(null, null);
+                    drop();
+                    reader.close();
+                }
+            }
+        } finally {
+            handlerThread.quitSafely();
+            capture.release();
+        }
+    }
+
+    private void sendFrames() throws IOException {
+        ByteBuffer frame = ByteBuffer.allocate(8);
+        while (!stopped.get() && !captureControl.isResetRequested() && !capture.isClosed()) {
+            Image image;
+            try {
+                image = available.poll(100, TimeUnit.MILLISECONDS);
+            } catch (InterruptedException e) {
+                return;
+            }
+            if (image == null) {
+                continue;
+            }
+            // Only the newest picture matters; older ones go back to Android at once.
+            Image newer;
+            while ((newer = available.poll()) != null) {
+                image.close();
+                image = newer;
+            }
+            // The Mac copies the resource as soon as it hears of it, so the drawing must be done.
+            image.getFence().await(Duration.ofSeconds(1));
+            HardwareBuffer buffer = image.getHardwareBuffer();
+            int resource = buffer != null ? resourceId(buffer) : 0;
+            if (buffer != null) {
+                buffer.close();
+            }
+            if (resource == 0) {
+                Ln.w("A frame has no virtio-gpu resource");
+                image.close();
+                continue;
+            }
+            int number = ++frameNumber & 0x7FFF_FFFF;
+            synchronized (sent) {
+                // A Mac that stopped returning frames must not leave Android without buffers.
+                if (sent.size() >= MAX_IMAGES - 2) {
+                    Integer oldest = sent.keySet().stream().min(Integer::compare).orElse(null);
+                    if (oldest != null) {
+                        sent.remove(oldest).close();
+                    }
+                }
+                sent.put(number, image);
+            }
+            frame.clear();
+            frame.putInt(resource).putInt(number).flip();
+            IO.writeFully(fd, frame);
+        }
+    }
+
+    private void drop() {
+        Image image;
+        while ((image = available.poll()) != null) {
+            image.close();
+        }
+        synchronized (sent) {
+            for (Image sentImage : sent.values()) {
+                sentImage.close();
+            }
+            sent.clear();
+        }
+    }
+
+    @Override
+    public void start(TerminationListener listener) {
+        thread = new Thread(() -> {
+            Looper.prepare();
+            try {
+                stream();
+            } catch (ConfigurationException e) {
+                // logged already
+            } catch (IOException e) {
+                if (!IO.isBrokenPipe(e)) {
+                    Ln.e("Frame streaming error", e);
+                }
+            } finally {
+                listener.onTerminated(true);
+            }
+        }, "video");
+        thread.start();
+    }
+
+    @Override
+    public void stop() {
+        if (thread != null) {
+            stopped.set(true);
+            captureControl.reset(CaptureControl.RESET_REASON_TERMINATED);
+        }
+    }
+
+    @Override
+    public void join() throws InterruptedException {
+        if (thread != null) {
+            thread.join();
+        }
+    }
+}
