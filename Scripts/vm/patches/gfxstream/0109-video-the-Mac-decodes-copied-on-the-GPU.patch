+using Bytes = std::vector<uint8_t>;
+
+// MARK: - Reading the streams' headers
+
+/// Reads bits, the most significant first, as the VP9 and AV1 specifications write them.
+struct Bits {
+    const uint8_t* data;
+    size_t size;
+    size_t position = 0;
+
+    uint64_t f(int count) {
+        uint64_t value = 0;
+        for (int i = 0; i < count; i++) {
+            uint8_t byte = position / 8 < size ? data[position / 8] : 0;
+            value = value << 1 | ((byte >> (7 - position % 8)) & 1);
+            position++;
+        }
+        return value;
+    }
+
+    uint64_t uvlc() {
+        int zeros = 0;
+        while (position < size * 8 && f(1) == 0) zeros++;
+        return zeros >= 32 ? UINT32_MAX : f(zeros) + (1ull << zeros) - 1;
+    }
+};
+
+/// What a VP9 key frame or an AV1 sequence header says the pictures are made with.
+struct StreamHeader {
+    Bytes key;  // changes when the session must be made anew
+    CMVideoFormatDescriptionRef description = nullptr;
+    bool showsExisting = false;
+};
+
+CMVideoFormatDescriptionRef MakeDescription(CMVideoCodecType type, int width, int height,
+                                            NSString* atom, const Bytes& record) {
+    NSDictionary* extensions = @{
+        (__bridge NSString*)kCMFormatDescriptionExtension_SampleDescriptionExtensionAtoms :
+            @{atom : [NSData dataWithBytes:record.data() length:record.size()]},
+    };
+    CMVideoFormatDescriptionRef description = nullptr;
+    CMVideoFormatDescriptionCreate(nullptr, type, width, height, (__bridge CFDictionaryRef)extensions,
+                                   &description);
+    return description;
+}
+
+/// A VP9 key frame's uncompressed header (VP9 bitstream specification, 6.2).
+std::optional<StreamHeader> VP9Header(const Bytes& data) {
+    Bits bits{data.data(), std::min<size_t>(data.size(), 32)};
+    if (bits.f(2) != 2) return std::nullopt;
+    int low = bits.f(1);
+    int profile = (int)bits.f(1) << 1 | low;
+    if (profile == 3) bits.f(1);
+    if (bits.f(1) == 1) return StreamHeader{.showsExisting = true};
+    if (bits.f(1) != 0) return std::nullopt;  // not a key frame
+    bits.f(2);
+    if (bits.f(8) != 0x49 || bits.f(8) != 0x83 || bits.f(8) != 0x42) return std::nullopt;
+    int depth = profile >= 2 ? (bits.f(1) ? 12 : 10) : 8;
+    int space = bits.f(3);
+    int fullRange = 1, subsampling = 1;  // 4:2:0
+    if (space != 7) {
+        fullRange = bits.f(1);
+        if (profile == 1 || profile == 3) {
+            int x = bits.f(1), y = bits.f(1);
+            bits.f(1);
+            subsampling = x && y ? 1 : x ? 2 : 3;
+        }
+    } else if (profile == 1 || profile == 3) {
+        subsampling = 3;
+        bits.f(1);
+    }
+    int width = bits.f(16) + 1, height = bits.f(16) + 1;
+    // ITU-T H.273 codes for its colour space.
+    uint8_t primaries = 2, transfer = 2, matrix = 2;
+    switch (space) {
+        case 1: case 3: primaries = transfer = matrix = 6; break;
+        case 2: primaries = transfer = matrix = 1; break;
+        case 4: primaries = transfer = matrix = 7; break;
+        case 5: primaries = 9; transfer = 14; matrix = 9; break;
+        case 7: primaries = 1; transfer = 13; matrix = 0; break;
+    }
+    Bytes vpcC = {1, 0, 0, 0, (uint8_t)profile, 0, (uint8_t)(depth << 4 | subsampling << 1 | fullRange),
+                  primaries, transfer, matrix, 0, 0};
+    Bytes key = vpcC;
+    for (int value : {width, height}) for (int i = 0; i < 4; i++) key.push_back(value >> (8 * i));
+    return StreamHeader{key, MakeDescription(kCMVideoCodecType_VP9, width, height, @"vpcC", vpcC)};
+}
+
+std::optional<StreamHeader> AV1SequenceHeader(const Bytes& obu, const uint8_t* payload, size_t size) {
+    Bits bits{payload, size};
+    int profile = bits.f(3);
+    bits.f(1);  // still_picture
+    bool reduced = bits.f(1);
+    int level = 0, tier = 0;
+    if (reduced) {
+        level = bits.f(5);
+    } else {
+        bool decoderModel = false;
+        int bufferDelayLength = 0;
+        if (bits.f(1)) {  // timing_info
+            bits.f(32);
+            bits.f(32);
+            if (bits.f(1)) bits.uvlc();
+            decoderModel = bits.f(1);
+            if (decoderModel) {
+                bufferDelayLength = bits.f(5) + 1;
+                bits.f(32);
+                bits.f(5);
+                bits.f(5);
+            }
+        }
+        bool initialDisplayDelay = bits.f(1);
+        int points = bits.f(5) + 1;
+        for (int point = 0; point < points; point++) {
+            bits.f(12);
+            int pointLevel = bits.f(5);
+            int pointTier = pointLevel > 7 ? bits.f(1) : 0;
+            if (point == 0) {
+                level = pointLevel;
+                tier = pointTier;
+            }
+            if (decoderModel && bits.f(1)) {
+                bits.f(bufferDelayLength);
+                bits.f(bufferDelayLength);
+                bits.f(1);
+            }
+            if (initialDisplayDelay && bits.f(1)) bits.f(4);
+        }
+    }
+    int widthBits = bits.f(4) + 1, heightBits = bits.f(4) + 1;
+    int width = bits.f(widthBits) + 1, height = bits.f(heightBits) + 1;
+    if (!reduced && bits.f(1)) {  // frame_id_numbers_present
+        bits.f(4);
+        bits.f(3);
+    }
+    bits.f(3);  // 128x128 superblocks, filter intra, intra edge filter
+    if (!reduced) {
+        bits.f(4);  // interintra, masked compound, warped motion, dual filter
+        bool orderHint = bits.f(1);
+        if (orderHint) bits.f(2);
+        int screenContent = 2;
+        if (bits.f(1) == 0) screenContent = bits.f(1);
+        if (screenContent > 0 && bits.f(1) == 0) bits.f(1);
+        if (orderHint) bits.f(3);
+    }
+    bits.f(3);  // superres, cdef, restoration
+    int high = bits.f(1);
+    int twelve = profile == 2 && high ? bits.f(1) : 0;
+    int mono = profile == 1 ? 0 : bits.f(1);
+    int primaries = 2, transfer = 2, matrix = 2;
+    if (bits.f(1)) {
+        primaries = bits.f(8);
+        transfer = bits.f(8);
+        matrix = bits.f(8);
+    }
+    int x = 1, y = 1, position = 0;
+    if (!mono) {
+        if (primaries == 1 && transfer == 13 && matrix == 0) {
+            x = y = 0;
+        } else {
+            bits.f(1);  // color_range
+            if (profile == 1) {
+                x = y = 0;
+            } else if (profile == 2) {
+                if (twelve) {
+                    x = bits.f(1);
+                    y = x ? bits.f(1) : 0;
+                } else {
+                    y = 0;
+                }
+            }
+            if (x && y) position = bits.f(2);
+        }
+    }
+    Bytes record = {0x81, (uint8_t)(profile << 5 | level),
+                    (uint8_t)(tier << 7 | high << 6 | twelve << 5 | mono << 4 | x << 3 | y << 2 | position), 0};
+    record.insert(record.end(), obu.begin(), obu.end());
+    return StreamHeader{record, MakeDescription(kCMVideoCodecType_AV1, width, height, @"av1C", record)};
+}
+
+/// An AV1 sequence header, from a temporal unit's OBUs or from the AV1CodecConfigurationRecord
+/// an app gives first.
+std::optional<StreamHeader> AV1Header(const Bytes& data) {
+    size_t at = data.size() >= 4 && data[0] == 0x81 ? 4 : 0;
+    while (at < data.size()) {
+        uint8_t header = data[at];
+        int type = (header >> 3) & 0xf;
+        bool hasExtension = header & 4, hasSize = header & 2;
+        size_t payload = at + 1 + (hasExtension ? 1 : 0);
+        size_t size = data.size() - std::min(payload, data.size());
+        if (hasSize) {
+            size = 0;
+            for (int i = 0; i < 8; i++) {
+                if (payload >= data.size()) return std::nullopt;
+                uint8_t byte = data[payload++];
+                size |= (size_t)(byte & 0x7f) << (7 * i);
+                if (!(byte & 0x80)) break;
+            }
+        }
+        if (payload + size > data.size()) return std::nullopt;
+        if (type == 1) {
+            return AV1SequenceHeader(Bytes(data.begin() + at, data.begin() + payload + size),
+                                     data.data() + payload, size);
+        }
+        at = payload + size;
+    }
+    return std::nullopt;
+}
+
+/// NAL units between Annex B start codes.
+std::vector<Bytes> Units(const Bytes& data) {
+    std::vector<std::pair<size_t, size_t>> starts;
+    for (size_t i = 0; i + 2 < data.size();) {
+        if (data[i] == 0 && data[i + 1] == 0 && data[i + 2] == 1) {
+            starts.push_back({i, i + 3});
+            i += 3;
+        } else {
+            i++;
+        }
+    }
+    std::vector<Bytes> units;
+    if (starts.empty()) {
+        if (!data.empty()) units.push_back(data);
+        return units;
+    }
+    for (size_t n = 0; n < starts.size(); n++) {
+        size_t end = n + 1 < starts.size() ? starts[n + 1].first : data.size();
+        while (end > starts[n].second && data[end - 1] == 0) end--;
+        if (end > starts[n].second) units.emplace_back(data.begin() + starts[n].second, data.begin() + end);
+    }
+    return units;
+}
+
+/// How many pictures an HEVC stream may show before one decoded earlier: its SPS's
+/// sps_max_num_reorder_pics for the highest sub-layer (H.265, 7.3.2.2), or the most a level allows.
+int HEVCReorderDepth(const Bytes& sps) {
+    // The SPS's bits, after its 2-byte header and without emulation prevention bytes.
+    Bytes rbsp;
+    for (size_t i = 2; i < sps.size(); i++) {
+        if (i + 2 < sps.size() && sps[i] == 0 && sps[i + 1] == 0 && sps[i + 2] == 3) {
+            rbsp.push_back(0);
+            rbsp.push_back(0);
+            i += 2;
+        } else {
+            rbsp.push_back(sps[i]);
+        }
+    }
+    Bits bits{rbsp.data(), rbsp.size()};
+    auto ue = [&bits]() -> uint64_t {
+        int zeros = 0;
+        while (bits.position < bits.size * 8 && bits.f(1) == 0 && zeros < 32) zeros++;
+        return (1ull << zeros) - 1 + bits.f(zeros);
+    };
+    bits.f(4);  // sps_video_parameter_set_id
+    int maxSubLayers = bits.f(3);
+    bits.f(1);
+    bits.f(96);  // general profile, tier and level
+    std::vector<bool> profilePresent(maxSubLayers), levelPresent(maxSubLayers);
+    for (int i = 0; i < maxSubLayers; i++) {
+        profilePresent[i] = bits.f(1);
+        levelPresent[i] = bits.f(1);
+    }
+    if (maxSubLayers > 0) for (int i = maxSubLayers; i < 8; i++) bits.f(2);
+    for (int i = 0; i < maxSubLayers; i++) {
+        if (profilePresent[i]) bits.f(88);
+        if (levelPresent[i]) bits.f(8);
+    }
+    ue();  // sps_seq_parameter_set_id
+    if (ue() == 3) bits.f(1);  // chroma_format_idc, separate_colour_plane_flag
+    ue();
+    ue();  // pic_width, pic_height_in_luma_samples
+    if (bits.f(1)) for (int i = 0; i < 4; i++) ue();  // conformance window
+    ue();
+    ue();  // bit depths
+    ue();  // log2_max_pic_order_cnt_lsb_minus4
+    bool allLayers = bits.f(1);
+    int reorder = 6;
+    for (int i = allLayers ? 0 : maxSubLayers; i <= maxSubLayers; i++) {
+        ue();  // sps_max_dec_pic_buffering_minus1
+        reorder = (int)ue();
+        ue();  // sps_max_latency_increase_plus1
+    }
+    return bits.position <= bits.size * 8 && reorder <= 16 ? reorder : 6;
+}
+
+// MARK: - Copying pictures on the GPU
+
+/// The picture, planar 4:2:0 in an IOSurface, copied by Metal into the YV12 ColorBuffer the
+/// resource stands for: its planes Y, then Cr and Cb, as Android's YV12 lays them out.
+bool CopyIntoResource(CVPixelBufferRef image, uint32_t resource) {
+    uint32_t handle = 0, width = 0, height = 0;
+    IOSurfaceRef surface = CVPixelBufferGetIOSurface(image);
+    if (!surface || IOSurfaceGetPlaneCount(surface) != 3) {
+        GFXSTREAM_ERROR("Inquiline's decoder: picture without a planar IOSurface");
+        return false;
+    }
+    if (stream_renderer_inquiline_color_buffer(resource, &handle, &width, &height) != 0) {
+        GFXSTREAM_ERROR("Inquiline's decoder: resource %u has no ColorBuffer", resource);
+        return false;
+    }
+    auto* frameBuffer = host::FrameBuffer::getFB();
+    if (!frameBuffer) return false;
+    bool reached = false;
+    bool copied = frameBuffer->copyIntoColorBufferImage(handle, [&](void* device, void* queue, void* image,
+                                                             void* getDeviceProcAddr) {
+        reached = true;
+        auto getProc = (PFN_vkGetDeviceProcAddr)getDeviceProcAddr;
+        auto exportObjects =
+            (PFN_vkExportMetalObjectsEXT)getProc((VkDevice)device, "vkExportMetalObjectsEXT");
+        if (!exportObjects) {
+            GFXSTREAM_ERROR("Inquiline's decoder: no vkExportMetalObjectsEXT");
+            return false;
+        }
+        VkExportMetalTextureInfoEXT planes[3];
+        const VkImageAspectFlagBits aspects[3] = {VK_IMAGE_ASPECT_PLANE_0_BIT, VK_IMAGE_ASPECT_PLANE_1_BIT,
+                                                  VK_IMAGE_ASPECT_PLANE_2_BIT};
+        VkExportMetalCommandQueueInfoEXT queueInfo = {
+            .sType = VK_STRUCTURE_TYPE_EXPORT_METAL_COMMAND_QUEUE_INFO_EXT,
+            .queue = (VkQueue)queue,
+        };
+        VkExportMetalDeviceInfoEXT deviceInfo = {.sType = VK_STRUCTURE_TYPE_EXPORT_METAL_DEVICE_INFO_EXT,
+                                                 .pNext = &queueInfo};
+        const void* next = &deviceInfo;
+        for (int i = 2; i >= 0; i--) {
+            planes[i] = {.sType = VK_STRUCTURE_TYPE_EXPORT_METAL_TEXTURE_INFO_EXT,
+                         .pNext = next,
+                         .image = (VkImage)image,
+                         .plane = aspects[i]};
+            next = &planes[i];
+        }
+        VkExportMetalObjectsInfoEXT objects = {.sType = VK_STRUCTURE_TYPE_EXPORT_METAL_OBJECTS_INFO_EXT,
+                                               .pNext = next};
+        exportObjects((VkDevice)device, &objects);
+        id<MTLDevice> mtlDevice = deviceInfo.mtlDevice;
+        id<MTLCommandQueue> mtlQueue = queueInfo.mtlCommandQueue;
+        if (!mtlDevice || !mtlQueue || !planes[0].mtlTexture || !planes[1].mtlTexture || !planes[2].mtlTexture) {
+            GFXSTREAM_ERROR("Inquiline's decoder: ColorBuffer %u has no Metal planes (%ux%u)", handle, width, height);
+            return false;
+        }
+        @autoreleasepool {
+            id<MTLCommandBuffer> commands = [mtlQueue commandBuffer];
+            id<MTLBlitCommandEncoder> blit = [commands blitCommandEncoder];
+            // The ColorBuffer's planes: Y, then the first and second chroma in YV12's memory
+            // order, Cr and Cb; the IOSurface's: Y, Cb, Cr.
+            const int sourcePlane[3] = {0, 2, 1};
+            for (int i = 0; i < 3; i++) {
+                int plane = sourcePlane[i];
+                MTLTextureDescriptor* descriptor = [MTLTextureDescriptor
+                    texture2DDescriptorWithPixelFormat:MTLPixelFormatR8Unorm
+                                                 width:IOSurfaceGetWidthOfPlane(surface, plane)
+                                                height:IOSurfaceGetHeightOfPlane(surface, plane)
+                                             mipmapped:NO];
+                descriptor.usage = MTLTextureUsageShaderRead;
+                descriptor.storageMode = MTLStorageModeShared;
+                id<MTLTexture> source = [mtlDevice newTextureWithDescriptor:descriptor iosurface:surface plane:plane];
+                id<MTLTexture> target = planes[i].mtlTexture;
+                if (!source) {
+                    [blit endEncoding];
+                    return false;
+                }
+                MTLSize size = MTLSizeMake(std::min(source.width, target.width),
+                                           std::min(source.height, target.height), 1);
+                [blit copyFromTexture:source sourceSlice:0 sourceLevel:0 sourceOrigin:MTLOriginMake(0, 0, 0)
+                           sourceSize:size toTexture:target destinationSlice:0 destinationLevel:0
+                    destinationOrigin:MTLOriginMake(0, 0, 0)];
+                [source release];  // the command buffer keeps it until it completes (no ARC here)
+            }
+            [blit endEncoding];
+            [commands commit];
+            [commands waitUntilCompleted];
+            return commands.status == MTLCommandBufferStatusCompleted;
+        }
+    });
+    if (!reached) GFXSTREAM_ERROR("Inquiline's decoder: ColorBuffer %u isn't Vulkan's alone", handle);
+    return copied;
+}
+
+// MARK: - A decoder's session
+
+class DecodeSession {
+public:
+    DecodeSession(int socket, const Bytes& token) : mSocket(socket), mToken(token) {}
+
+    ~DecodeSession() {
+        makeSession(nullptr);
+        dropWaiting();
+        for (auto& [index, image] : mHeld) CVPixelBufferRelease(image);
+        if (mLastImage) CVPixelBufferRelease(mLastImage);
+        if (mFormat) CFRelease(mFormat);
+        close(mSocket);
+    }
+
+    void run() {
+        uint8_t hello[37];
+        if (!receive(hello, sizeof(hello)) || memcmp(hello, "IQC1", 4) != 0 || !same(hello + 4) ||
+            hello[36] < 1 || hello[36] > 4) {
+            return;
+        }
+        mCodec = hello[36];
+        mReorderDepth = mCodec == 1 ? 4 : mCodec == 4 ? 6 : 0;
+        if (!sendByte(0)) return;
+        uint8_t request;
+        while (receive(&request, 1)) {
+            if (request == 'D') {
+                uint8_t head[24];
+                if (!receive(head, sizeof(head))) return;
+                uint64_t index, time;
+                uint32_t flags, size;
+                memcpy(&index, head, 8);
+                memcpy(&time, head + 8, 8);
+                memcpy(&flags, head + 16, 4);
+                memcpy(&size, head + 20, 4);
+                if (size > (64u << 20)) return;
+                Bytes data(size);
+                if (size && !receive(data.data(), size)) return;
+                @autoreleasepool {
+                    decode(data, index, (int64_t)time, flags & 1);
+                }
+                if (!answer(ready(false))) return;
+            } else if (request == 'E') {
+                if (!answer(ready(true))) return;
+            } else if (request == 'F') {
+                if (mSession) VTDecompressionSessionWaitForAsynchronousFrames(mSession);
+                dropWaiting();
+                for (auto& [index, image] : mHeld) CVPixelBufferRelease(image);
+                mHeld.clear();
+                if (!answer({})) return;
+            } else if (request == 'P') {
+                uint8_t body[20];
+                if (!receive(body, sizeof(body))) return;
+                uint64_t index;
+                uint32_t resource;
+                memcpy(&index, body, 8);
+                memcpy(&resource, body + 8, 4);
+                bool written = false;
+                auto it = mHeld.find(index);
+                if (it == mHeld.end()) GFXSTREAM_ERROR("Inquiline's decoder: no picture %llu held", (unsigned long long)index);
+                if (it != mHeld.end()) {
+                    @autoreleasepool {
+                        written = CopyIntoResource(it->second, resource);
+                    }
+                    CVPixelBufferRelease(it->second);
+                    mHeld.erase(it);
+                }
+                if (!sendByte(written ? 0 : 1)) return;
+            } else {
+                return;
+            }
+        }
+    }
+
+private:
+    /// An input on its way through the Mac's decoder, which decodes while Android sends the
+    /// next: a phone's hardware decoder works on several at once too.
+    struct Waiting {
+        uint64_t index;
+        int64_t time;
+        CVPixelBufferRef image = nullptr;  // retained; null when the input made no picture
+        bool done = false;
+    };
+    struct Picture {
+        uint64_t index;
+        uint32_t width, height;
+    };
+
+    void decode(const Bytes& data, uint64_t index, int64_t time, bool configOnly) {
+        if (mCodec == 1 || mCodec == 4) return decodeUnits(data, index, time, configOnly);
+        auto header = mCodec == 2 ? VP9Header(data) : AV1Header(data);
+        if (header && header->description) {
+            if (header->key != mStreamFormat) {
+                mStreamFormat = header->key;
+                makeSession(header->description);
+            }
+            CFRelease(header->description);
+        }
+        if (configOnly) return;
+        if (header && header->showsExisting) {
+            // A frame that only shows an earlier one again, once that one is decoded.
+            if (mSession) VTDecompressionSessionWaitForAsynchronousFrames(mSession);
+            std::lock_guard<std::mutex> lock(mLock);
+            auto entry = std::make_shared<Waiting>(Waiting{index, time});
+            if (mLastImage) entry->image = CVPixelBufferRetain(mLastImage);
+            entry->done = true;
+            mWaiting.push_back(entry);
+            return;
+        }
+        decodeSample(data, index, time);
+    }
+
+    /// The kind of an H.264 or HEVC NAL unit, from its header.
+    int unitType(const Bytes& unit) const {
+        if (unit.empty()) return -1;
+        return mCodec == 4 ? (unit[0] >> 1) & 0x3f : unit[0] & 0x1f;
+    }
+
+    /// One access unit as Android gives it, H.264 or HEVC NAL units with start codes. Their
+    /// parameter sets (H.264's SPS and PPS, HEVC's VPS, SPS and PPS) make the session.
+    void decodeUnits(const Bytes& data, uint64_t index, int64_t time, bool configOnly) {
+        const bool hevc = mCodec == 4;
+        const std::vector<int> setTypes = hevc ? std::vector<int>{32, 33, 34} : std::vector<int>{7, 8};
+        const int delimiter = hevc ? 35 : 9;
+        std::vector<Bytes> units;
+        std::map<int, Bytes> sets;
+        for (auto& unit : Units(data)) {
+            int type = unitType(unit);
+            if (std::find(setTypes.begin(), setTypes.end(), type) != setTypes.end()) sets[type] = unit;
+            else if (type != delimiter && type >= 0 && !(hevc && unit.size() < 2)) units.push_back(unit);
+        }
+        if (!sets.empty()) {
+            std::vector<Bytes> fresh;
+            for (int type : setTypes) {
+                if (sets.count(type)) fresh.push_back(sets[type]);
+                else for (auto& set : mParameterSets) if (unitType(set) == type) fresh.push_back(set);
+            }
+            if (fresh != mParameterSets) {
+                mParameterSets = fresh;
+                CMVideoFormatDescriptionRef description = nullptr;
+                if (mParameterSets.size() == setTypes.size()) {
+                    std::vector<const uint8_t*> pointers;
+                    std::vector<size_t> sizes;
+                    for (auto& set : mParameterSets) {
+                        pointers.push_back(set.data());
+                        sizes.push_back(set.size());
+                    }
+                    if (hevc) {
+                        mReorderDepth = HEVCReorderDepth(mParameterSets[1]);
+                        CMVideoFormatDescriptionCreateFromHEVCParameterSets(nullptr, 3, pointers.data(), sizes.data(), 4,
+                                                                           nullptr, &description);
+                    } else {
+                        // Baseline streams show each picture as it comes; others may hold some back.
+                        mReorderDepth = mParameterSets[0].size() > 1 && mParameterSets[0][1] == 66 ? 0 : 4;
+                        CMVideoFormatDescriptionCreateFromH264ParameterSets(nullptr, 2, pointers.data(), sizes.data(), 4,
+                                                                           &description);
+                    }
+                }
+                makeSession(description);
+                if (description) CFRelease(description);
+            }
+        }
+        if (configOnly) return;
+        if (units.empty()) {
+            std::lock_guard<std::mutex> lock(mLock);
+            mWaiting.push_back(std::make_shared<Waiting>(Waiting{index, time, nullptr, true}));
+            return;
+        }
+        Bytes sample;
+        for (auto& unit : units) {
+            uint32_t length = htonl((uint32_t)unit.size());
+            sample.insert(sample.end(), (uint8_t*)&length, (uint8_t*)&length + 4);
+            sample.insert(sample.end(), unit.begin(), unit.end());
+        }
+        decodeSample(sample, index, time);
+    }
+
+    /// Starts decoding one sample in the session as it is now; its picture joins the waiting
+    /// ones when the Mac's decoder has made it. At most one more is decoded while Android sends
+    /// the next, so a picture is never more than one input late.
+    void decodeSample(const Bytes& sample, uint64_t index, int64_t time) {
+        auto entry = std::make_shared<Waiting>(Waiting{index, time});
+        {
+            std::lock_guard<std::mutex> lock(mLock);
+            mWaiting.push_back(entry);
+        }
+        CMSampleBufferRef buffer = nullptr;
+        CMBlockBufferRef block = nullptr;
+        if (mSession && mFormat && !sample.empty() &&
+            CMBlockBufferCreateWithMemoryBlock(nullptr, nullptr, sample.size(), nullptr, nullptr, 0,
+                                               sample.size(), kCMBlockBufferAssureMemoryNowFlag,
+                                               &block) == noErr) {
+            CMBlockBufferReplaceDataBytes(sample.data(), block, 0, sample.size());
+            CMSampleTimingInfo timing = {kCMTimeInvalid, CMTimeMake(time, 1000000), kCMTimeInvalid};
+            size_t size = sample.size();
+            CMSampleBufferCreateReady(nullptr, block, mFormat, 1, 1, &timing, 1, &size, &buffer);
+            CFRelease(block);
+        }
+        OSStatus started = -1;
+        if (buffer) {
+            started = VTDecompressionSessionDecodeFrameWithOutputHandler(
+                mSession, buffer, kVTDecodeFrame_EnableAsynchronousDecompression, nullptr,
+                ^(OSStatus status, VTDecodeInfoFlags, CVImageBufferRef decoded, CMTime, CMTime) {
+                  std::lock_guard<std::mutex> lock(mLock);
+                  if (status == noErr && decoded && !entry->image) {
+                      entry->image = CVPixelBufferRetain(decoded);
+                      if (mLastImage) CVPixelBufferRelease(mLastImage);
+                      mLastImage = CVPixelBufferRetain(decoded);
+                  }
+                  entry->done = true;
+                  mDecoded.notify_all();
+                });
+            CFRelease(buffer);
+        }
+        std::unique_lock<std::mutex> lock(mLock);
+        if (started != noErr) entry->done = true;
+        mDecoded.wait(lock, [this] {
+            return std::count_if(mWaiting.begin(), mWaiting.end(), [](auto& e) { return !e->done; }) <= 1;
+        });
+    }
+
+    void dropWaiting() {
+        std::lock_guard<std::mutex> lock(mLock);
+        for (auto& entry : mWaiting) if (entry->image) CVPixelBufferRelease(entry->image);
+        mWaiting.clear();
+    }
+
+    void makeSession(CMVideoFormatDescriptionRef description) {
+        if (mSession) {
+            VTDecompressionSessionWaitForAsynchronousFrames(mSession);
+            VTDecompressionSessionInvalidate(mSession);
+            CFRelease(mSession);
+            mSession = nullptr;
+        }
+        if (mFormat) {
+            CFRelease(mFormat);
+            mFormat = nullptr;
+        }
+        if (!description) return;
+        // Planar 4:2:0 in IOSurfaces Metal reads: the Mac's media engine writes them, and the GPU
+        // copies them into Android's buffers.
+        NSDictionary* attributes = @{
+            (__bridge NSString*)kCVPixelBufferPixelFormatTypeKey : @(kCVPixelFormatType_420YpCbCr8Planar),
+            (__bridge NSString*)kCVPixelBufferIOSurfacePropertiesKey : @{},
+            (__bridge NSString*)kCVPixelBufferMetalCompatibilityKey : @YES,
+        };
+        NSDictionary* specification = @{
+            (__bridge NSString*)kVTVideoDecoderSpecification_EnableHardwareAcceleratedVideoDecoder : @YES,
+        };
+        VTDecompressionSessionRef session = nullptr;
+        VTDecompressionSessionCreate(nullptr, description, (__bridge CFDictionaryRef)specification,
+                                     (__bridge CFDictionaryRef)attributes, nullptr, &session);
+        if (session) VTSessionSetProperty(session, kVTDecompressionPropertyKey_RealTime, kCFBooleanTrue);
+        mSession = session;
+        mFormat = (CMVideoFormatDescriptionRef)CFRetain(description);
+    }
+
+    /// Pictures whose turn has come, in the order they are shown; all of them at the end.
+    std::vector<Picture> ready(bool all) {
+        if (all && mSession) VTDecompressionSessionWaitForAsynchronousFrames(mSession);
+        std::lock_guard<std::mutex> lock(mLock);
+        std::vector<Picture> out;
+        // An input that made no picture is done at once.
+        for (auto& entry : mWaiting) if (entry->done && !entry->image) out.push_back({entry->index, 0, 0});
+        mWaiting.erase(std::remove_if(mWaiting.begin(), mWaiting.end(),
+                                      [](auto& e) { return e->done && !e->image; }),
+                       mWaiting.end());
+        std::stable_sort(mWaiting.begin(), mWaiting.end(), [](auto& a, auto& b) { return a->time < b->time; });
+        // The earliest shown goes first, once decoded; a later one never passes it.
+        while (!mWaiting.empty() && mWaiting.front()->done && (all || mWaiting.size() > (size_t)mReorderDepth)) {
+            auto entry = mWaiting.front();
+            mWaiting.erase(mWaiting.begin());
+            if (!entry->image) {
+                out.push_back({entry->index, 0, 0});
+                continue;
+            }
+            auto old = mHeld.find(entry->index);
+            if (old != mHeld.end()) CVPixelBufferRelease(old->second);
+            mHeld[entry->index] = entry->image;
+            out.push_back({entry->index, (uint32_t)CVPixelBufferGetWidth(entry->image) & ~1u,
+                           (uint32_t)CVPixelBufferGetHeight(entry->image) & ~1u});
+        }
+        return out;
+    }
+
+    bool answer(const std::vector<Picture>& pictures) {
+        Bytes out(4 + 16 * pictures.size());
+        uint32_t count = pictures.size();
+        memcpy(out.data(), &count, 4);
+        for (size_t i = 0; i < pictures.size(); i++) {
+            memcpy(out.data() + 4 + 16 * i, &pictures[i].index, 8);
+            memcpy(out.data() + 12 + 16 * i, &pictures[i].width, 4);
+            memcpy(out.data() + 16 + 16 * i, &pictures[i].height, 4);
+        }
+        return sendAll(out.data(), out.size());
+    }
+
+    bool receive(void* data, size_t size) {
+        auto* bytes = static_cast<uint8_t*>(data);
+        while (size > 0) {
+            ssize_t got = recv(mSocket, bytes, size, 0);
+            if (got <= 0) return false;
+            bytes += got;
+            size -= got;
+        }
+        return true;
+    }
+
+    bool sendAll(const void* data, size_t size) {
+        auto* bytes = static_cast<const uint8_t*>(data);
+        while (size > 0) {
+            ssize_t sent = send(mSocket, bytes, size, 0);
+            if (sent <= 0) return false;
+            bytes += sent;
+            size -= sent;
+        }
+        return true;
+    }
+
+    bool sendByte(uint8_t byte) { return sendAll(&byte, 1); }
+
+    /// Compares in the same time whatever the bytes, so the token can't be guessed by timing.
+    bool same(const uint8_t* token) {
+        uint8_t difference = mToken.size() == 32 ? 0 : 1;
+        for (size_t i = 0; i < 32 && i < mToken.size(); i++) difference |= token[i] ^ mToken[i];
+        return difference == 0;
+    }
+
+    int mSocket;
+    Bytes mToken;
+    int mCodec = 1;
+    int mReorderDepth = 4;
+    VTDecompressionSessionRef mSession = nullptr;
+    CMVideoFormatDescriptionRef mFormat = nullptr;
+    std::vector<Bytes> mParameterSets;
+    Bytes mStreamFormat;
+    // The decoder's own threads finish pictures; the lock guards what they write.
+    std::mutex mLock;
+    std::condition_variable mDecoded;
+    CVPixelBufferRef mLastImage = nullptr;
+    std::vector<std::shared_ptr<Waiting>> mWaiting;
+    std::map<uint64_t, CVPixelBufferRef> mHeld;
+};
+
+void startVideoDecoder() {
+    const char* portText = getenv("INQUILINE_DECODER_PORT");
+    const char* tokenText = getenv("INQUILINE_DECODER_TOKEN");
+    if (!portText || !tokenText || strlen(tokenText) != 64) return;
+    Bytes token;
+    for (int i = 0; i < 32; i++) token.push_back((uint8_t)strtoul(std::string(tokenText + 2 * i, 2).c_str(), nullptr, 16));
+    VTRegisterSupplementalVideoDecoderIfAvailable(kCMVideoCodecType_VP9);
+    VTRegisterSupplementalVideoDecoderIfAvailable(kCMVideoCodecType_AV1);
+    int listener = socket(AF_INET, SOCK_STREAM, 0);
+    sockaddr_in address = {};
+    address.sin_family = AF_INET;
+    address.sin_port = htons((uint16_t)atoi(portText));
+    address.sin_addr.s_addr = htonl(INADDR_LOOPBACK);
+    int on = 1;
+    setsockopt(listener, SOL_SOCKET, SO_REUSEADDR, &on, sizeof(on));
+    if (listener < 0 || bind(listener, (sockaddr*)&address, sizeof(address)) != 0 || listen(listener, 8) != 0) {
+        GFXSTREAM_ERROR("Inquiline's video decoder could not listen on port %s", portText);
+        if (listener >= 0) close(listener);
+        return;
+    }
+    std::thread([listener, token] {
+        while (true) {
+            int client = accept(listener, nullptr, nullptr);
+            if (client < 0) continue;
+            int on = 1;
+            setsockopt(client, IPPROTO_TCP, TCP_NODELAY, &on, sizeof(on));
+            setsockopt(client, SOL_SOCKET, SO_NOSIGPIPE, &on, sizeof(on));
+            std::thread([client, token] {
+                @autoreleasepool {
+                    DecodeSession(client, token).run();
+                }
+            }).detach();
+        }
+    }).detach();
+}
