+// Inquiline: hands Android's frames to the Mac app windows without video encoding.
+//
+// Each window process connects to the Unix socket named by INQUILINE_FRAMES_SOCKET and
+// gets a POSIX shared memory object from it ('M'), which it maps and unlinks. For each frame
+// the guest reports, the window asks for a virtio-gpu resource to be copied there ('C'): the
+// GPU copies the ColorBuffer into the shared memory, and the window draws it with Metal.
+// Every request gets a one-byte answer, 0 on success. Little-endian throughout.
+//
+//   'M' u64 size                       answer, then u16 name length and name
+//   'C' u32 resource id, u64 offset    copy the resource's pixels (RGBA8) at offset
+
+#include <fcntl.h>
+#include <stdint.h>
+#include <stdlib.h>
+#include <string.h>
+#include <sys/mman.h>
+#include <sys/socket.h>
+#include <sys/un.h>
+#include <unistd.h>
+
+#include <atomic>
+#include <string>
+#include <thread>
+
+#include "frame_buffer.h"
+#include "gfxstream/common/logging.h"
+#include "gfxstream/virtio-gpu-gfxstream-renderer-unstable.h"
+
+namespace gfxstream {
+namespace {
+
+bool readAll(int fd, void* data, size_t size) {
+    auto* bytes = static_cast<uint8_t*>(data);
+    while (size > 0) {
+        ssize_t got = read(fd, bytes, size);
+        if (got <= 0) return false;
+        bytes += got;
+        size -= got;
+    }
+    return true;
+}
+
+void unmap(void* base, uint64_t size) {
+    if (auto* fb = host::FrameBuffer::getFB()) fb->forgetHostMemory(base);
+    munmap(base, size);
+}
+
+void serve(int client) {
+    void* base = nullptr;
+    uint64_t size = 0;
+    uint8_t request;
+    while (readAll(client, &request, 1)) {
+        uint8_t status = 1;
+        std::string name;
+        if (request == 'M') {
+            uint64_t newSize;
+            if (!readAll(client, &newSize, 8)) break;
+            if (base) {
+                unmap(base, size);
+                base = nullptr;
+            }
+            static std::atomic<uint32_t> count;
+            name = "/apkp." + std::to_string(getpid()) + "." + std::to_string(count++);
+            shm_unlink(name.c_str());
+            int memory = shm_open(name.c_str(), O_RDWR | O_CREAT | O_EXCL, 0600);
+            if (memory >= 0) {
+                void* mapped = ftruncate(memory, newSize) == 0
+                    ? mmap(nullptr, newSize, PROT_READ | PROT_WRITE, MAP_SHARED, memory, 0)
+                    : MAP_FAILED;
+                close(memory);
+                if (mapped != MAP_FAILED) {
+                    base = mapped;
+                    size = newSize;
+                    status = 0;
+                } else {
+                    shm_unlink(name.c_str());
+                }
+            }
+        } else if (request == 'C') {
+            uint32_t resource;
+            uint64_t offset;
+            if (!readAll(client, &resource, 4) || !readAll(client, &offset, 8)) break;
+            if (base) status = stream_renderer_mini_scanout(resource, base, size, offset) == 0 ? 0 : 1;
+        } else {
+            break;
+        }
+        if (write(client, &status, 1) != 1) break;
+        if (request == 'M' && status == 0) {
+            uint16_t nameLength = name.size();
+            if (write(client, &nameLength, 2) != 2 || write(client, name.data(), nameLength) != nameLength) break;
+        }
+    }
+    if (base) unmap(base, size);
+    close(client);
+}
+
+void startFrameServer() {
+    const char* path = getenv("INQUILINE_FRAMES_SOCKET");
+    if (!path || !*path) return;
+    int listener = socket(AF_UNIX, SOCK_STREAM, 0);
+    sockaddr_un address = {.sun_family = AF_UNIX};
+    if (listener < 0 || strlen(path) >= sizeof(address.sun_path)) return;
+    strcpy(address.sun_path, path);
+    unlink(path);
+    if (bind(listener, reinterpret_cast<sockaddr*>(&address), sizeof(address)) != 0 ||
+        listen(listener, 8) != 0) {
+        GFXSTREAM_ERROR("Inquiline frame server could not listen on %s", path);
+        close(listener);
+        return;
+    }
+    std::thread([listener] {
+        while (true) {
+            int client = accept(listener, nullptr, nullptr);
+            if (client >= 0) std::thread(serve, client).detach();
+        }
+    }).detach();
+}
+
+}  // namespace
+}  // namespace gfxstream
+
+extern "C" void startInquilineFrameServer() { gfxstream::startFrameServer(); }
