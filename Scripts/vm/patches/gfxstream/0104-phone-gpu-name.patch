+    // Inquiline: many games run at 30 FPS on a GPU they don't know, as Apple's is to them, and
+    // at 60 only on the phone GPUs they list. Android's apps see one of those by name; what
+    // the GPU can do is still the Mac's, as the rest of its properties say.
+    static void setPhoneGpuName(VkPhysicalDeviceProperties* props) {
+        snprintf(props->deviceName, sizeof(props->deviceName), "%s", "Adreno (TM) 740");
+    }
