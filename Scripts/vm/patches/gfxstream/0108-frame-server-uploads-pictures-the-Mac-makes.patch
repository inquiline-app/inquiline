+// Inquiline: a picture the Mac made for the guest, as the video it decodes, written into the
+// resource's ColorBuffer whole, in the layout the guest itself writes it in.
+int VirtioGpuFrontend::miniUpload(int resId, const void* data, uint64_t size) {
+    auto it = mResources.find(resId);
+    if (it == mResources.end()) {
+        return EINVAL;
+    }
+    auto handle = it->second.GetColorBufferHandle();
+    const auto& args = it->second.GetCreateArgs();
+    if (!handle || !args) {
+        return EINVAL;
+    }
+    auto format = ToGfxstreamFormat(args->format);
+    const size_t needed = GetTransferSize(args->format, args->width, args->height, 0, 0, args->width, args->height);
+    if (!format || needed == 0 || size < needed) {
+        return EINVAL;
+    }
+    return FrameBuffer::getFB()->updateColorBuffer(*handle, 0, 0, args->width, args->height, *format,
+                                                   const_cast<void*>(data)) ? 0 : EIO;
+}
