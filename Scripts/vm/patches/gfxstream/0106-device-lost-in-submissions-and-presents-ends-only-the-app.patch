 DeviceOpBuilder::~DeviceOpBuilder() {
+    // Inquiline: a submission that failed, as when the app's VkDevice was lost, returns its
+    // error to the app before the fence is handed over. Its own fence, never submitted, goes
+    // now; ending the engine for it would end every app.
     if (!mSubmittedFence) {
-        GFXSTREAM_FATAL("Invalid usage: failed to call OnQueueSubmittedWithFence().");
+        GFXSTREAM_ERROR("A queue submission failed before its fence was submitted.");
+        if (mCreatedFence.has_value() && *mCreatedFence != VK_NULL_HANDLE) {
+            mTracker.mDeviceDispatch->vkDestroyFence(mTracker.mDevice, *mCreatedFence, nullptr);
+        }
     }
 }
 
