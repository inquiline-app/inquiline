+/// A 10-bit HDR picture (two planes, Y and CbCr), made SDR into the ColorBuffer's planes:
+/// Y, Cr, Cb, as YV12 lays them out.
+bool ToneMapInto(id<MTLDevice> device, id<MTLCommandQueue> queue, IOSurfaceRef surface,
+                 CVPixelBufferRef image, id<MTLTexture> const targets[3]) {
+    CFStringRef transfer = (CFStringRef)CVBufferCopyAttachment(image, kCVImageBufferTransferFunctionKey, nullptr);
+    bool hlg = transfer && CFEqual(transfer, kCVImageBufferTransferFunction_ITU_R_2100_HLG);
+    if (transfer) CFRelease(transfer);
+    struct { uint32_t mode; float peak; } params = {hlg ? 2u : 1u, SourcePeak(image, hlg)};
+
+    ToneMapper& mapper = TheToneMapper();
+    std::lock_guard<std::mutex> guard(mapper.lock);
+    if (mapper.device != device) {
+        [mapper.pipeline release];
+        for (auto& plane : mapper.planes) { [plane release]; plane = nil; }
+        mapper.pipeline = nil;
+        mapper.device = device;
+        NSError* error = nil;
+        id<MTLLibrary> library = [device newLibraryWithSource:@(kToneMapSource) options:nil error:&error];
+        id<MTLFunction> function = [library newFunctionWithName:@"toneMap"];
+        if (function) mapper.pipeline = [device newComputePipelineStateWithFunction:function error:&error];
+        [function release];
+        [library release];
+        if (!mapper.pipeline) {
+            GFXSTREAM_ERROR("Inquiline video: the HDR tone mapping didn't compile: %s",
+                            error.localizedDescription.UTF8String);
+            mapper.device = nil;
+            return false;
+        }
+    }
+    const size_t width = IOSurfaceGetWidthOfPlane(surface, 0), height = IOSurfaceGetHeightOfPlane(surface, 0);
+    const size_t sizes[3][2] = {{width, height}, {(width + 1) / 2, (height + 1) / 2}, {(width + 1) / 2, (height + 1) / 2}};
+    for (int i = 0; i < 3; i++) {
+        if (mapper.planes[i] && mapper.planes[i].width == sizes[i][0] && mapper.planes[i].height == sizes[i][1]) continue;
+        [mapper.planes[i] release];
+        MTLTextureDescriptor* descriptor = [MTLTextureDescriptor texture2DDescriptorWithPixelFormat:MTLPixelFormatR8Unorm
+                                                                                              width:sizes[i][0]
+                                                                                             height:sizes[i][1]
+                                                                                          mipmapped:NO];
+        descriptor.usage = MTLTextureUsageShaderWrite | MTLTextureUsageShaderRead;
+        descriptor.storageMode = MTLStorageModePrivate;
+        mapper.planes[i] = [device newTextureWithDescriptor:descriptor];
+        if (!mapper.planes[i]) return false;
+    }
+    id<MTLTexture> sources[2] = {nil, nil};
+    const MTLPixelFormat formats[2] = {MTLPixelFormatR16Unorm, MTLPixelFormatRG16Unorm};
+    for (int plane = 0; plane < 2; plane++) {
+        MTLTextureDescriptor* descriptor = [MTLTextureDescriptor
+            texture2DDescriptorWithPixelFormat:formats[plane]
+                                         width:IOSurfaceGetWidthOfPlane(surface, plane)
+                                        height:IOSurfaceGetHeightOfPlane(surface, plane)
+                                     mipmapped:NO];
+        descriptor.usage = MTLTextureUsageShaderRead;
+        descriptor.storageMode = MTLStorageModeShared;
+        sources[plane] = [device newTextureWithDescriptor:descriptor iosurface:surface plane:plane];
+    }
+    bool done = false;
+    if (sources[0] && sources[1]) {
+        id<MTLCommandBuffer> commands = [queue commandBuffer];
+        id<MTLComputeCommandEncoder> compute = [commands computeCommandEncoder];
+        [compute setComputePipelineState:mapper.pipeline];
+        [compute setTexture:sources[0] atIndex:0];
+        [compute setTexture:sources[1] atIndex:1];
+        for (int i = 0; i < 3; i++) [compute setTexture:mapper.planes[i] atIndex:2 + i];
+        [compute setBytes:&params length:sizeof(params) atIndex:0];
+        [compute dispatchThreads:MTLSizeMake(sizes[1][0], sizes[1][1], 1) threadsPerThreadgroup:MTLSizeMake(16, 16, 1)];
+        [compute endEncoding];
+        id<MTLBlitCommandEncoder> blit = [commands blitCommandEncoder];
+        const int order[3] = {0, 2, 1};  // the ColorBuffer's Y, Cr, Cb
+        for (int i = 0; i < 3; i++) {
+            id<MTLTexture> source = mapper.planes[order[i]];
+            MTLSize size = MTLSizeMake(std::min(source.width, targets[i].width),
+                                       std::min(source.height, targets[i].height), 1);
+            [blit copyFromTexture:source sourceSlice:0 sourceLevel:0 sourceOrigin:MTLOriginMake(0, 0, 0)
+                       sourceSize:size toTexture:targets[i] destinationSlice:0 destinationLevel:0
+                destinationOrigin:MTLOriginMake(0, 0, 0)];
