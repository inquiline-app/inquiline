+/// The compiled kernel and its planes, made once for the GPU and kept, for one picture at a time.
+struct ToneMapper {
+    std::mutex lock;
+    id<MTLDevice> device = nil;
+    id<MTLComputePipelineState> pipeline = nil;
+    id<MTLTexture> planes[3] = {nil, nil, nil};  // Y, Cb, Cr
+};
+
+ToneMapper& TheToneMapper() {
+    static ToneMapper mapper;
+    return mapper;
+}
+
+/// The peak brightness the picture was made for, in nits: its content light level, or its
+/// mastering display's, or HDR10's usual 1000.
+float SourcePeak(CVPixelBufferRef image, bool hlg) {
+    if (hlg) return 1000;
+    float peak = 0;
+    if (CFTypeRef level = CVBufferCopyAttachment(image, kCVImageBufferContentLightLevelInfoKey, nullptr)) {
+        if (CFGetTypeID(level) == CFDataGetTypeID() && CFDataGetLength((CFDataRef)level) >= 2) {
+            const uint8_t* bytes = CFDataGetBytePtr((CFDataRef)level);
+            peak = bytes[0] << 8 | bytes[1];
+        }
+        CFRelease(level);
+    }
+    if (peak <= 0) {
+        if (CFTypeRef volume = CVBufferCopyAttachment(image, kCVImageBufferMasteringDisplayColorVolumeKey, nullptr)) {
+            if (CFGetTypeID(volume) == CFDataGetTypeID() && CFDataGetLength((CFDataRef)volume) >= 20) {
+                const uint8_t* b = CFDataGetBytePtr((CFDataRef)volume) + 16;
+                peak = (uint32_t)(b[0] << 24 | b[1] << 16 | b[2] << 8 | b[3]) / 10000.0f;
+            }
+            CFRelease(volume);
+        }
+    }
+    if (peak <= 0) peak = 1000;
+    return std::clamp(peak, 400.0f, 10000.0f);
+}
