+// MARK: - HDR made SDR
+//
+// Android's apps take HDR video (PQ or HLG, BT.2020) when the display can show it; the Mac's
+// media engine decodes it in 10 bits, and here the GPU makes each picture SDR BT.709, as a
+// phone with an SDR screen does, into the same YV12 buffer as any video's: libplacebo's
+// BT.2390 tone mapping (src/tone_mapping.c, src/shaders/colorspace.c), on the brightest of a
+// pixel's red, green and blue so hues stay, then BT.2020 to BT.709 primaries. VideoToolbox's
+// own conversion only retags HDR pictures, without mapping them (tried on macOS 26).
+
+const char* kToneMapSource = R"(
+#include <metal_stdlib>
+using namespace metal;
+struct Params { uint mode; float peak; };
+constant float m1 = 0.1593017578125, m2 = 78.84375, c1 = 0.8359375, c2 = 18.8515625, c3 = 18.6875;
+constant float kWhite = 203.0; // SDR white in nits (ITU-R BT.2408)
+float pqToNits(float e) {
+    float p = pow(max(e, 0.0), 1.0 / m2);
+    return 10000.0 * pow(max(p - c1, 0.0) / (c2 - c3 * p), 1.0 / m1);
+}
+float nitsToPq(float nits) {
+    float y = pow(max(nits, 0.0) / 10000.0, m1);
+    return pow((c1 + c2 * y) / (1.0 + c3 * y), m2);
+}
+float hlgToScene(float e) {
+    const float a = 0.17883277, b = 0.28466892, c = 0.55991073;
+    return e <= 0.5 ? e * e / 3.0 : (exp((e - c) / a) + b) / 12.0;
+}
+// ITU-R BT.2390 EETF, in PQ, from the source's peak to SDR white.
+float bt2390(float e, float sourcePeak, float targetPeak) {
+    float x = e / sourcePeak, maxLum = targetPeak / sourcePeak;
+    float ks = 1.5 * maxLum - 0.5;
+    if (ks < 1.0 && x > ks) {
+        float t = (x - ks) / (1.0 - ks), t2 = t * t, t3 = t2 * t;
+        x = (2.0 * t3 - 3.0 * t2 + 1.0) * ks + (t3 - 2.0 * t2 + t) * (1.0 - ks) + (-2.0 * t3 + 3.0 * t2) * maxLum;
+    }
+    return min(x, maxLum) * sourcePeak;
+}
+// A pixel's limited-range 10-bit BT.2020 Y'CbCr, as SDR BT.709 R'G'B'.
+float3 sdr(float luma, float2 chroma, constant Params& p) {
+    float y = (luma * 65535.0 / 64.0 - 64.0) / 876.0;
+    float cb = (chroma.x * 65535.0 / 64.0 - 512.0) / 896.0, cr = (chroma.y * 65535.0 / 64.0 - 512.0) / 896.0;
+    float3 rgb = clamp(float3(y + 1.4746 * cr, y - 0.16455 * cb - 0.57135 * cr, y + 1.8814 * cb), 0.0, 1.0);
+    float3 nits;
+    if (p.mode == 1) {
+        nits = float3(pqToNits(rgb.r), pqToNits(rgb.g), pqToNits(rgb.b));
+    } else {
+        // HLG on a 1000-nit display: its OOTF, system gamma 1.2.
+        float3 scene = float3(hlgToScene(rgb.r), hlgToScene(rgb.g), hlgToScene(rgb.b));
+        float ys = dot(scene, float3(0.2627, 0.6780, 0.0593));
+        nits = 1000.0 * pow(max(ys, 1e-6), 0.2) * scene;
+    }
+    float brightest = max(max(nits.r, nits.g), nits.b);
+    if (brightest > 0.0) {
+        float mapped = pqToNits(bt2390(nitsToPq(brightest), nitsToPq(p.peak), nitsToPq(kWhite)));
+        nits *= mapped / brightest;
+    }
+    float3 linear2020 = nits / kWhite;
+    float3 linear709 = float3(dot(linear2020, float3(1.6605, -0.5876, -0.0728)),
+                              dot(linear2020, float3(-0.1246, 1.1329, -0.0083)),
+                              dot(linear2020, float3(-0.0182, -0.1006, 1.1187)));
+    return pow(clamp(linear709, 0.0, 1.0), 1.0 / 2.4);
+}
+// One thread for each 2x2 block: four lumas and the block's chroma, limited-range BT.709.
+kernel void toneMap(texture2d<float, access::read> lumaIn [[texture(0)]],
+                    texture2d<float, access::read> chromaIn [[texture(1)]],
+                    texture2d<float, access::write> lumaOut [[texture(2)]],
+                    texture2d<float, access::write> cbOut [[texture(3)]],
+                    texture2d<float, access::write> crOut [[texture(4)]],
+                    constant Params& p [[buffer(0)]], uint2 block [[thread_position_in_grid]]) {
+    if (block.x >= cbOut.get_width() || block.y >= cbOut.get_height()) return;
+    uint2 lastChroma = uint2(chromaIn.get_width() - 1, chromaIn.get_height() - 1);
+    uint2 lastLuma = uint2(lumaIn.get_width() - 1, lumaIn.get_height() - 1);
+    float2 chroma = chromaIn.read(min(block, lastChroma)).rg;
+    float3 sum = 0.0;
+    for (uint i = 0; i < 4; i++) {
+        uint2 at = block * 2 + uint2(i & 1, i >> 1);
+        float3 rgb = sdr(lumaIn.read(min(at, lastLuma)).r, chroma, p);
+        sum += rgb;
+        if (at.x < lumaOut.get_width() && at.y < lumaOut.get_height())
+            lumaOut.write(float4((16.0 + 219.0 * dot(rgb, float3(0.2126, 0.7152, 0.0722))) / 255.0), at);
+    }
+    float3 rgb = sum / 4.0;
+    float y = dot(rgb, float3(0.2126, 0.7152, 0.0722));
+    cbOut.write(float4((128.0 + 224.0 * (rgb.b - y) / 1.8556) / 255.0), block);
+    crOut.write(float4((128.0 + 224.0 * (rgb.r - y) / 1.5748) / 255.0), block);
+}
+)";
