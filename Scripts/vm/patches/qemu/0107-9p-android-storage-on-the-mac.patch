+            gid = true;
         }
         if (fgetxattrat_nofollow(dirfd, name, "user.virtfs.mode", &tmp_mode,
                                  sizeof(mode_t)) > 0) {
             stbuf->st_mode = le32_to_cpu(tmp_mode);
+            mode = true;
         }
+        inquiline_unmapped(stbuf, uid, gid, mode);
         if (fgetxattrat_nofollow(dirfd, name, "user.virtfs.rdev", &tmp_dev,
                                  sizeof(dev_t)) > 0) {
             stbuf->st_rdev = le64_to_cpu(tmp_dev);
@@ -799,18 +846,24 @@ static int local_fstat(FsContext *fs_ctx, int fid_type,
         mode_t tmp_mode;
