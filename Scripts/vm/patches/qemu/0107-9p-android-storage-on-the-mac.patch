         if (qemu_fgetxattr(fd, "user.virtfs.rdev",
                            &tmp_dev, sizeof(dev_t)) > 0) {
             stbuf->st_rdev = le64_to_cpu(tmp_dev);
@@ -1471,6 +1524,10 @@ static int local_init(FsContext *ctx, Error **errp)
