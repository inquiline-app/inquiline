Inquiline: Android's shared storage on the Mac. Files made on the Mac, which have
no mapped credentials, belong to Android's storage (media_rw), so Android's apps
can change them; and the share's "0" folder, Android's first user's storage, is
INQUILINE_STORAGE, so the Mac shows it as a folder of its own.

diff --git a/hw/9pfs/9p-local.c b/hw/9pfs/9p-local.c
index ee592b62f8..32892436b4 100644
--- a/hw/9pfs/9p-local.c
+++ b/hw/9pfs/9p-local.c
@@ -56,13 +56,33 @@
 
 typedef struct {
     int mountfd;
+    /*
+     * Inquiline: the share's "0" folder, Android's storage for its first user,
+     * is this folder instead (INQUILINE_STORAGE), so the Mac shows it by
+     * itself, as the user's Android folder. -1 without it.
+     */
+    int storagefd;
 } LocalData;
 
+static int inquiline_open_storage(LocalData *data, int fd, const char *head,
+                                  int flags, mode_t mode, bool last, bool *root)
+{
+    /* Paths start at the share's root as "./"; "0" there is the storage. */
+    bool at_root = *root;
+    *root = at_root && !strcmp(head, ".");
+    if (!at_root || data->storagefd == -1 || strcmp(head, "0")) {
+        return last ? openat_file(fd, head, flags, mode) : openat_dir(fd, head);
+    }
+    return last ? openat_file(data->storagefd, ".", flags & ~O_CREAT, mode)
+                : openat_dir(data->storagefd, ".");
+}
+
 int local_open_nofollow(FsContext *fs_ctx, const char *path, int flags,
                         mode_t mode)
 {
     LocalData *data = fs_ctx->private;
     int fd = data->mountfd;
+    bool root = true;
 
     while (*path && fd != -1) {
         const char *c;
@@ -78,10 +98,10 @@ int local_open_nofollow(FsContext *fs_ctx, const char *path, int flags,
             /* Intermediate path element */
             head[c - path] = 0;
             path = c + 1;
-            next_fd = openat_dir(fd, head);
+            next_fd = inquiline_open_storage(data, fd, head, flags, mode, false, &root);
         } else {
             /* Rightmost path element */
-            next_fd = openat_file(fd, head, flags, mode);
+            next_fd = inquiline_open_storage(data, fd, head, flags, mode, true, &root);
             path = c;
         }
         g_free(head);
@@ -183,6 +203,27 @@ static void local_mapped_file_attr(int dirfd, const char *name,
     fclose(fp);
 }
 
+/*
+ * Inquiline: a file made on the Mac has no mapped credentials. It belongs to
+ * Android's shared storage (media_rw, 1023), as a file copied onto a phone's
+ * storage does, so Android's apps can change and delete it.
+ */
+#define INQUILINE_STORAGE_ID 1023
+
+static void inquiline_unmapped(struct stat *stbuf, bool uid, bool gid, bool mode)
+{
+    if (!uid) {
+        stbuf->st_uid = INQUILINE_STORAGE_ID;
+    }
+    if (!gid) {
+        stbuf->st_gid = INQUILINE_STORAGE_ID;
+    }
+    if (!mode && (S_ISDIR(stbuf->st_mode) || S_ISREG(stbuf->st_mode))) {
+        stbuf->st_mode = (stbuf->st_mode & S_IFMT) |
+                         (S_ISDIR(stbuf->st_mode) ? 02770 : 0660);
+    }
+}
+
