+/*
+ * Inquiline: the blocks are sorted once and each gap found by binary search, rather than a
+ * scan of every block for every block. Graphics map a block for each buffer they share, so a
+ * game holds hundreds, and the quadratic scan held the main loop for most of every frame.
+ * The offset chosen is the same: the smallest gap that fits, after the first such block.
+ */
+typedef struct RAMSpan {
+    ram_addr_t start, end;
+} RAMSpan;
+
+static int ram_span_compare(const void *a, const void *b)
+{
+    ram_addr_t x = ((const RAMSpan *)a)->start, y = ((const RAMSpan *)b)->start;
+
+    return x < y ? -1 : x > y;
+}
