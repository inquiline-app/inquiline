+/*
+ * Inquiline: how long a sample the host's sound backend has just been given waits before the
+ * Mac's sound device plays it (its IO cycle's output time), in microseconds; 0 while unknown.
+ * The app reads it (virtio-sound's "output-delay-us") to keep the guest's sound with its picture.
+ */
+extern int64_t audio_host_output_delay_us;
