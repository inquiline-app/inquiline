--- a/audio/coreaudio.m	2026-11-26 10:33:04
+++ b/audio/coreaudio.m	2026-11-26 10:33:04
@@ -352,6 +352,21 @@
         out += write_len;
     }
 
+    /*
+     * Inquiline: the newest sample waits for this cycle, which the device plays from its output
+     * time, and for what is left after it (audio_host_output_delay_us), smoothed over cycles.
+     */
+    if (inNow && inOutputTime && (inNow->mFlags & kAudioTimeStampHostTimeValid) &&
+        (inOutputTime->mFlags & kAudioTimeStampHostTimeValid) && hw->info.freq > 0) {
+        int64_t ahead = (int64_t)(AudioConvertHostTimeToNanos(inOutputTime->mHostTime) / 1000) -
+                        (int64_t)(AudioConvertHostTimeToNanos(inNow->mHostTime) / 1000);
+        int64_t waiting = (int64_t)(hw->pending_emul / hw->info.bytes_per_frame + frame_size) *
+                          1000000 / hw->info.freq;
+        int64_t delay = ahead + waiting;
+        int64_t old = qatomic_read(&audio_host_output_delay_us);
+        qatomic_set(&audio_host_output_delay_us, old > 0 ? old + (delay - old) / 32 : delay);
+    }
+
     coreaudio_voice_out_buf_unlock(core, "out_device_ioproc");
     return 0;
 }
