<?xml version="1.0" encoding="utf-8"?>
<!-- Hands Android's notifications to Inquiline, which shows them in the Mac's Notification Center. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="io.github.inquiline.notifications"
    android:versionCode="4"
    android:versionName="4">
    <uses-sdk android:minSdkVersion="35" android:targetSdkVersion="35" />
    <application android:label="Mac Notifications" android:hasCode="true" android:allowBackup="false">
        <service
            android:name=".Listener"
            android:label="Mac Notifications"
            android:exported="true"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>
    </application>
</manifest>
