<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- The widget extension in each Android app's Mac app: sandboxed, and only Inquiline's widgets
     folder open to it, where it reads pictures and leaves requests (Widgets/AndroidWidgets.swift).
     An App Group would need a paid Apple certificate; this exception doesn't. -->
<plist version="1.0">
<dict>
	<key>com.apple.security.app-sandbox</key>
	<true/>
	<key>com.apple.security.temporary-exception.files.home-relative-path.read-write</key>
	<array>
		<string>/Library/Application Support/Inquiline/widgets/</string>
	</array>
</dict>
</plist>
